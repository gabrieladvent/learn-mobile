# Contoh isi env/dev.env — SALIN berkas ini jadi `env/dev.env`, lalu isi
# nilainya. Yang asli tidak ikut ter-commit (lihat .gitignore).
#
# Dipakai dengan:
#   flutter run --flavor dev --dart-define-from-file=env/dev.env

# Alamat backend. 10.0.2.2 = localhost Mac dilihat dari emulator Android.
# Perangkat fisik: pakai IP laptop, atau `adb reverse tcp:8000 tcp:8000`.
API_BASE_URL=http://10.0.2.2:8000/api/v1

# Nama lingkungan. Muncul sebagai `environment` di Sentry.
FLAVOR=dev

# DSN Sentry. Kosongkan kalau tidak ingin mengirim laporan crash sama sekali —
# tanpa nilai ini, pelaporan mati total (lihat ADR-0018).
SENTRY_DSN=
